# Copie para .env e preencha conforme necessário.
# O .env tem precedência sobre config/settings.json para estes campos.

# Prefixo dos comandos (ex.: !)
# BOT_PREFIX=!

# Número(s) do dono, separados por vírgula, só dígitos com DDI.
# Ex.: 5511999999999,5511888888888
# OWNER_NUMBERS=

# Conectar por código em vez de QR: número do BOT (só dígitos com DDI).
# Só é usado quando não há sessão salva (data/session vazio).
# PAIRING_NUMBER=5511999999999

# API para o portal enviar mensagens (src/api.js). Só liga com API_TOKEN.
# Gere um token longo: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# API_TOKEN=
# API_PORT=3000
# Grupo usado quando o portal não manda "grupo" (id termina em @g.us; veja GET /grupos).
# API_DEFAULT_GROUP=
# Grupo da Masayoshi. Quem está nele usa o bot; o privado ({ numero, mensagem })
# também só vai para quem está nele. De fora: só com liberação no portal (bot_guests).
# Grupo aberto: quem é de fora usa o bot só dentro dele (sem nada da Masayoshi): BOT_PUBLIC_GROUP.
# Contato para quem não tem permissão (só dígitos com DDI): BOT_CONTACT_NUMBER e BOT_CONTACT_NAME.
# API_DM_GROUP=
# Só se o portal chamar a API direto do navegador (ex.: https://meuportal.com).
# API_CORS_ORIGIN=

# Avisos automáticos do portal (src/automations.js). Sem os dois, ficam desligados.
# SUPABASE_URL=https://lldzgkxpoyqauxdcjyaw.supabase.co
# Chave SECRETA (service_role / sb_secret_...) — nunca no git nem no navegador.
# SUPABASE_SERVICE_KEY=

# Transcrição de áudio (/ouvir) com o Whisper large-v3 da Groq (cota grátis).
# Chave em https://console.groq.com/keys — nunca no git.
# GROQ_API_KEY=
