# Copie para .env e preencha conforme necessário.
# O .env tem precedência sobre config/settings.json para estes campos.

# Prefixo dos comandos (ex.: !)
# BOT_PREFIX=!

# Número(s) do dono, separados por vírgula, só dígitos com DDI.
# Ex.: 5511999999999,5511888888888
# OWNER_NUMBERS=

# Conectar por código em vez de QR: número do BOT (só dígitos com DDI).
# Só é usado quando não há sessão salva (data/session vazio).
# PAIRING_NUMBER=5511999999999

# API para o portal enviar mensagens (src/api.js). Só liga com API_TOKEN.
# Gere um token longo: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# API_TOKEN=
# API_PORT=3000
# Grupo usado quando o portal não manda "grupo" (id termina em @g.us; veja GET /grupos).
# API_DEFAULT_GROUP=
# Liga o envio no privado ({ numero, mensagem }) só para membros deste grupo.
# API_DM_GROUP=
# Só se o portal chamar a API direto do navegador (ex.: https://meuportal.com).
# API_CORS_ORIGIN=
